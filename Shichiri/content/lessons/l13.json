{
  "id": "l13",
  "number": 13,
  "moduleId": "m3",
  "title": "谈兴趣、喜欢与擅长",
  "subtitle": "接住别人的兴趣，同时区分喜欢与做得好。",
  "revision": 2,
  "goals": [
    "说明自己的喜好并询问对方。",
    "回应共同兴趣，并区分兴趣与能力。",
    "在『社团介绍桌』以外的同类情境中，能根据对方回应调整自己的文字回答。"
  ],
  "prerequisites": [
    "已完成第12课及此前课目，遇到不理解时会请求重复和确认。",
    "先回忆已学名词、助词及相关动词；本课材料支持词可结合中文释义理解。"
  ],
  "days": [
    {
      "day": 1,
      "title": "整体理解",
      "description": "围绕「谈兴趣、喜欢与擅长」完成整体理解；每块约20分钟，可与同组其他块连续学习。",
