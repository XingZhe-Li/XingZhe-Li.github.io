  "grammar": [
    {
      "id": "l13-g1",
      "title": "喜好对象",
      "meaning": "说明自己的喜好并询问对方。",
      "pattern": "名词が好きです",
      "explanation": "好き是な形容词，喜好对象常用が；对比时可以用は。",
      "examples": [
        {
          "ja": "アニメが好きです。",
          "zh": "喜欢动画。"
        }
      ],
      "pitfall": "喜欢不等于擅长。"
    },
    {
      "id": "l13-g2",
      "title": "共同点与特长",
      "meaning": "回应共同兴趣，并区分兴趣与能力。",
      "pattern": "も；得意です",
      "explanation": "私も表示我也；得意是擅长，喜欢做某事并不证明做得好。上手先用于理解或称赞他人。",
      "examples": [
        {
          "ja": "私も読書が好きです。",
          "zh": "我也喜欢读书。"
        }
      ],
      "pitfall": "不要从喜欢旅行推断去过很多国家。"
    }
  ],
