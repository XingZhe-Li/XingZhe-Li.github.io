  "masteryCriteria": [
    "不看文本听『社团介绍桌』后，能记录最终决定或状态，并把未确认的信息标为未知。",
    "从两篇阅读中找到四道阅读题的依据，区分『社团成员的兴趣卡』与变体材料的条件。",
    "关闭说明后，能在情境中使用名词が好きです及も；得意です，而不只会背变形名称。",
    "换人物、时间、数量或条件后能用文字完成合适回应；实际口语与现场轮流接话需另行检验。"
  ],
  "dialogues": [
    {
      "id": "l13-d01",
      "title": "社团介绍桌",
      "context": "介绍爱好时不要求夸大自己的技能。 本段配单声部合成教学朗读，并非真人会话。",
