  "grammar": [
    {
      "id": "l17-g1",
      "title": "辞书条目",
      "meaning": "将熟悉动作对应到词典形式。",
      "pattern": "読みます→読む；食べます→食べる",
      "explanation": "本课的原形用于查词和观察，不要求立即在正式服务场合改用普通体。先查已学动词。",
      "examples": [
        {
          "ja": "「読みます」の辞書形は「読む」です。",
          "zh": "読みます的辞书形是読む。"
        }
      ],
      "pitfall": "不是所有动词都去ます加る。"
    },
    {
      "id": "l17-g2",
      "title": "分组与例外",
      "meaning": "认识本课动词的不同对应规律。",
      "pattern": "一组／二组／三组",
      "explanation": "買う、読む等为一组；食べる、見る等二组；する、来る三组。帰る虽然以る结尾，属于一组。",
      "examples": [
        {
          "ja": "「帰る」は一グループです。",
          "zh": "帰る是一组动词。"
        }
      ],
      "pitfall": "不能仅凭最后一个る判二组。"
    }
  ],
