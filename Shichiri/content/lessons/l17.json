  "masteryCriteria": [
    "不看文本听『查阅读的词典形式』后，能记录最终决定或状态，并把未确认的信息标为未知。",
    "从两篇阅读中找到四道阅读题的依据，区分『词典查词卡』与变体材料的条件。",
    "关闭说明后，能在情境中使用読みます→読む；食べます→食べる及一组／二组／三组，而不只会背变形名称。",
    "换人物、时间、数量或条件后能用文字完成合适回应；实际口语与现场轮流接话需另行检验。"
  ],
  "dialogues": [
    {
      "id": "l17-d01",
      "title": "查阅读的词典形式",
      "context": "对话中的原形是被引用的词条，不是随意对服务人员使用简体。 本段配单声部合成教学朗读，并非真人会话。",
      "audioId": "l17-dialogue-synth",
      "lines": [
        {
          "speaker": "学習者",
          "ja": "「読みます」は辞書にありますか。",
          "kana": "よみますはじしょにありますか。",
          "zh": "词典有読みます吗？"
        },
        {
          "speaker": "先生",
          "ja": "「読む」です。",
          "kana": "よむです。",
          "zh": "查読む。"
        },
        {
          "speaker": "学習者",
          "ja": "「食べます」は「食べる」ですか。",
          "kana": "たべますはたべるですか。",
          "zh": "食べます是食べる吗？"
        },
        {
          "speaker": "先生",
          "ja": "はい、二グループです。",
          "kana": "はい、にグループです。",
          "zh": "是，二组。"
        },
        {
          "speaker": "学習者",
          "ja": "「帰る」も二グループですか。",
          "kana": "かえるもにグループですか。",
          "zh": "帰る也是二组吗？"
        },
        {
          "speaker": "先生",
          "ja": "いいえ、一グループです。",
          "kana": "いいえ、いちグループです。",
          "zh": "不，是一组。"
        },
        {
          "speaker": "学習者",
          "ja": "「来ます」はどうですか。",
          "kana": "きますはどうですか。",
          "zh": "来ます呢？"
        },
        {
          "speaker": "先生",
          "ja": "辞書形は「来る」です。",
          "kana": "じしょけいはくるです。",
          "zh": "辞书形是来る。"
        }
      ]
    }
  ],
