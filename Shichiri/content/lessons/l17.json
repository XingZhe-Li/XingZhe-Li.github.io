{
  "id": "l17",
  "number": 17,
  "moduleId": "m4",
  "title": "认识动词原形并学会查词",
  "subtitle": "从已学礼貌形找到词典条目，不把分组当作背字尾游戏。",
  "revision": 2,
  "goals": [
    "将熟悉动作对应到词典形式。",
    "认识本课动词的不同对应规律。",
    "在『查阅读的词典形式』以外的同类情境中，能根据对方回应调整自己的文字回答。"
  ],
  "prerequisites": [
    "已完成第16课及此前课目，遇到不理解时会请求重复和确认。",
    "先回忆已学名词、助词及相关动词；本课材料支持词可结合中文释义理解。"
  ],
  "days": [
    {
      "day": 1,
      "title": "整体理解",
      "description": "围绕「认识动词原形并学会查词」完成整体理解；每块约20分钟，可与同组其他块连续学习。",
