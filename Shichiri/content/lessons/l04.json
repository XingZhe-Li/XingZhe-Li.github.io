  "masteryCriteria": [
    "不看文本听『买笔和橡皮』后，能记录最终决定或状态，并把未确认的信息标为未知。",
    "从两篇阅读中找到四道阅读题的依据，区分『柜台价格与订单』与变体材料的条件。",
    "关闭说明后，能在情境中使用物品はいくらですか及物品を＋数量＋ください，而不只会背变形名称。",
    "换人物、时间、数量或条件后能用文字完成合适回应；实际口语与现场轮流接话需另行检验。"
  ],
  "dialogues": [
    {
      "id": "l04-d01",
      "title": "买笔和橡皮",
      "context": "文具柜台价格明确；来客买的是少量物品。 本段配单声部合成教学朗读，并非真人会话。",
      "audioId": "l04-dialogue-synth",
      "lines": [
        {
          "speaker": "客",
          "ja": "このペンはいくらですか。",
          "kana": "このペンはいくらですか。",
          "zh": "这支笔多少钱？"
        },
        {
          "speaker": "店員",
          "ja": "百円です。",
          "kana": "ひゃくえんです。",
          "zh": "一百日元。"
        },
        {
          "speaker": "客",
          "ja": "ペンを二つください。",
          "kana": "ペンをふたつください。",
          "zh": "请给我两支笔。"
        },
        {
          "speaker": "店員",
          "ja": "二つですね。",
          "kana": "ふたつですね。",
          "zh": "两支，对吧。"
        },
        {
          "speaker": "客",
          "ja": "はい。消しゴムはいくらですか。",
          "kana": "はい。けしゴムはいくらですか。",
          "zh": "对。橡皮多少钱？"
        },
        {
          "speaker": "店員",
          "ja": "百円です。",
          "kana": "ひゃくえんです。",
          "zh": "一百日元。"
        },
        {
          "speaker": "客",
          "ja": "消しゴムを一つお願いします。",
          "kana": "けしゴムをひとつおねがいします。",
          "zh": "请给我一块橡皮。"
        },
        {
          "speaker": "店員",
          "ja": "全部で三百円です。",
          "kana": "ぜんぶでさんびゃくえんです。",
          "zh": "总共三百日元。"
        }
      ]
    }
  ],
