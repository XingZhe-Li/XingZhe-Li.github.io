  "grammar": [
    {
      "id": "l04-g1",
      "title": "价格疑问",
      "meaning": "询问本课物品的价格。",
      "pattern": "物品はいくらですか",
      "explanation": "いくら问金额，円表示日元。材料中的数词读法由本课词表支持。",
      "examples": [
        {
          "ja": "ペンは百円です。",
          "zh": "笔一百日元。"
        }
      ],
      "pitfall": "区分单价与合计。"
    },
    {
      "id": "l04-g2",
      "title": "数量请求",
      "meaning": "在购买请求中说清数量。",
      "pattern": "物品を＋数量＋ください",
      "explanation": "先把物品を…ください整体使用，数量放在ください前。一つ、二つ、三つ分别是1、2、3件。",
      "examples": [
        {
          "ja": "ペンを二つください。",
          "zh": "请给我两支笔。"
        }
      ],
      "pitfall": "数量不是金额。"
    }
  ],
