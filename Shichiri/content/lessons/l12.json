  "masteryCriteria": [
    "不看文本听『寻找安静房间』后，能记录最终决定或状态，并把未确认的信息标为未知。",
    "从两篇阅读中找到四道阅读题的依据，区分『小旅店的介绍』与变体材料的条件。",
    "关闭说明后，能在情境中使用静かです／静かじゃないです及な形容词＋な＋名词，而不只会背变形名称。",
    "换人物、时间、数量或条件后能用文字完成合适回应；实际口语与现场轮流接话需另行检验。"
  ],
  "dialogues": [
    {
      "id": "l12-d01",
      "title": "寻找安静房间",
      "context": "旅客只比较房间特点，不使用未学的比较结构。 本段配单声部合成教学朗读，并非真人会话。",
      "audioId": "l12-dialogue-synth",
      "lines": [
        {
          "speaker": "客",
          "ja": "この部屋は静かですか。",
          "kana": "このへやはしずかですか。",
          "zh": "这房间安静吗？"
        },
        {
          "speaker": "係",
          "ja": "はい、静かです。",
          "kana": "はい、しずかです。",
          "zh": "安静。"
        },
        {
          "speaker": "客",
          "ja": "駅の近くですか。",
          "kana": "えきのちかくですか。",
          "zh": "在车站附近吗？"
        },
        {
          "speaker": "係",
          "ja": "はい、便利です。",
          "kana": "はい、べんりです。",
          "zh": "是，很方便。"
        },
        {
          "speaker": "客",
          "ja": "あのホテルも静かですか。",
          "kana": "あのホテルもしずかですか。",
          "zh": "那酒店也安静吗？"
        },
        {
          "speaker": "係",
          "ja": "いいえ、にぎやかです。",
          "kana": "いいえ、にぎやかです。",
          "zh": "不，很热闹。"
        },
        {
          "speaker": "客",
          "ja": "このホテルの人は親切ですか。",
          "kana": "このホテルのひとはしんせつですか。",
          "zh": "这酒店的人亲切吗？"
        },
        {
          "speaker": "係",
          "ja": "はい、親切な人です。",
          "kana": "はい、しんせつなひとです。",
          "zh": "是，亲切的人。"
        }
      ]
    }
  ],
