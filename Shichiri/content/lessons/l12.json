{
  "id": "l12",
  "number": 12,
  "moduleId": "m3",
  "title": "描述地方与人物",
  "subtitle": "为安静、热闹与方便等特点选对对象和修饰形式。",
  "revision": 2,
  "goals": [
    "描述地方和人物的性质。",
    "辨认并组织名词前的性质说明。",
    "在『寻找安静房间』以外的同类情境中，能根据对方回应调整自己的文字回答。"
  ],
  "prerequisites": [
    "已完成第11课及此前课目，遇到不理解时会请求重复和确认。",
    "先回忆已学名词、助词及相关动词；本课材料支持词可结合中文释义理解。"
  ],
  "days": [
    {
      "day": 1,
      "title": "整体理解",
      "description": "围绕「描述地方与人物」完成整体理解；每块约20分钟，可与同组其他块连续学习。",
      "sections": [
        "dialogue",
        "reading",
        "practice"
      ],
      "exerciseIds": [
        "l12-ex01",
        "l12-ex03"
      ],
      "tasks": [
        {
          "title": "听读主材料",
          "instructions": "先不展开文本听「寻找安静房间」，记下双方的目标和最后的处理结果；再读分句核对，标出首次未听懂的词句。",
          "minutes": 10,
          "section": "dialogue"
        },
        {
          "title": "应用、核对与记录",
          "instructions": "阅读「小旅店的介绍」的情境，找出对象、条件和一项尚未确定的信息；完成本块题目并指出依据。",
          "minutes": 10,
          "section": "practice"
        }
      ]
    },
    {
      "day": 2,
      "title": "词汇与表达",
      "description": "围绕「描述地方与人物」完成词汇与表达；每块约20分钟，可与同组其他块连续学习。",
      "sections": [
        "vocabulary",
        "practice"
      ],
      "exerciseIds": [
        "l12-ex19",
        "l12-ex20",
        "l12-ex21",
        "l12-ex22"
      ],
      "tasks": [
        {
          "title": "在语境中认识词句",
          "instructions": "在主材料中找到静か、にぎやか、便利、不便，听独立朗读并结合例句确认当前词义，勿将全部识别词一次加入复习。",
          "minutes": 10,
          "section": "vocabulary"
        },
        {
          "title": "应用、核对与记录",
          "instructions": "遮住释义重做本块四道语境题，再用この部屋は静かですか。替换一个人物或条件；记下自己仍会混淆的搭配。",
          "minutes": 10,
          "section": "practice"
        }
      ]
    },
    {
      "day": 3,
      "title": "语法与替换",
      "description": "围绕「描述地方与人物」完成语法与替换；每块约20分钟，可与同组其他块连续学习。",
      "sections": [
        "grammar",
        "practice"
      ],
      "exerciseIds": [
        "l12-ex07",
        "l12-ex08",
        "l12-ex09"
      ],
      "tasks": [
        {
          "title": "比较规则与使用条件",
          "instructions": "对照「な形容词肯否」「修饰名词」的形式、作用和误区，给每条规则写一个适用条件和一个不适用条件。",
          "minutes": 10,
          "section": "grammar"
        },
        {
          "title": "应用、核对与记录",
          "instructions": "完成本块结构题；把一个例句的人物、时间或目的替换后重写，核对接续、否定和语气是否仍然成立。",
          "minutes": 10,
          "section": "practice"
        }
      ]
    },
    {
      "day": 4,
      "title": "听辨与回应",
      "description": "围绕「描述地方与人物」完成听辨与回应；每块约20分钟，可与同组其他块连续学习。",
