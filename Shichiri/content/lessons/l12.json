  "grammar": [
    {
      "id": "l12-g1",
      "title": "な形容词肯否",
      "meaning": "描述地方和人物的性质。",
      "pattern": "静かです／静かじゃないです",
      "explanation": "な形容词在です前不加な，否定用じゃないです。きれい虽以い结尾，也属于这类。",
      "examples": [
        {
          "ja": "この町は静かじゃないです。",
          "zh": "这个城镇不安静。"
        }
      ],
      "pitfall": "きれい不变成きれくない。"
    },
    {
      "id": "l12-g2",
      "title": "修饰名词",
      "meaning": "辨认并组织名词前的性质说明。",
      "pattern": "な形容词＋な＋名词",
      "explanation": "静かな部屋、親切な人；い形容词则直接接名词，如小さい部屋。",
      "examples": [
        {
          "ja": "静かな部屋です。",
          "zh": "是安静的房间。"
        }
      ],
      "pitfall": "不能把な插在所有形容词后。"
    }
  ],
