{
  "id": "l20",
  "number": 20,
  "moduleId": "m4",
  "title": "按顺序说明行动",
  "subtitle": "根据办事说明先寄包再入场，条件变更后重排步骤。",
  "revision": 2,
  "goals": [
    "连接连续行动。",
    "强调前项完成后才做后项。",
    "在『入场前寄包』以外的同类情境中，能根据对方回应调整自己的文字回答。"
  ],
  "prerequisites": [
    "已完成第19课及此前课目，遇到不理解时会请求重复和确认。",
    "先回忆已学名词、助词及相关动词；本课材料支持词可结合中文释义理解。"
  ],
  "days": [
    {
      "day": 1,
      "title": "整体理解",
      "description": "围绕「按顺序说明行动」完成整体理解；每块约20分钟，可与同组其他块连续学习。",
      "sections": [
        "dialogue",
        "reading",
        "practice"
      ],
