  "grammar": [
    {
      "id": "l20-g1",
      "title": "连接动作",
      "meaning": "连接连续行动。",
      "pattern": "Vて、Vます",
      "explanation": "把前一动作变て形，再接下一动作；本课用于顺序说明。",
      "examples": [
        {
          "ja": "受付に行って、名前を書きます。",
          "zh": "去接待处，然后写名字。"
        }
      ],
      "pitfall": "不要仅按出现的名词列表猜操作顺序。"
    },
    {
      "id": "l20-g2",
      "title": "明确先后",
      "meaning": "强调前项完成后才做后项。",
      "pattern": "Vてから、Vます",
      "explanation": "荷物を預けてから入ります明确先寄存后进入。",
      "examples": [
        {
          "ja": "切符を受け取ってから、入ります。",
          "zh": "取票后再进入。"
        }
      ],
      "pitfall": "てから不是两个动作同时进行。"
    }
