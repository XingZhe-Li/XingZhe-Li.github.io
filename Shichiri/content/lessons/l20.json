        "l20-ex01",
        "l20-ex03"
      ],
      "tasks": [
        {
          "title": "听读主材料",
          "instructions": "先不展开文本听「入场前寄包」，记下双方的目标和最后的处理结果；再读分句核对，标出首次未听懂的词句。",
          "minutes": 10,
          "section": "dialogue"
        },
        {
          "title": "应用、核对与记录",
          "instructions": "阅读「入场流程」的情境，找出对象、条件和一项尚未确定的信息；完成本块题目并指出依据。",
          "minutes": 10,
          "section": "practice"
        }
      ]
    },
    {
      "day": 2,
      "title": "词汇与表达",
