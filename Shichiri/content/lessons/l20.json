  "masteryCriteria": [
    "不看文本听『入场前寄包』后，能记录最终决定或状态，并把未确认的信息标为未知。",
    "从两篇阅读中找到四道阅读题的依据，区分『入场流程』与变体材料的条件。",
    "关闭说明后，能在情境中使用Vて、Vます及Vてから、Vます，而不只会背变形名称。",
    "换人物、时间、数量或条件后能用文字完成合适回应；实际口语与现场轮流接话需另行检验。"
  ],
  "dialogues": [
    {
      "id": "l20-d01",
      "title": "入场前寄包",
      "context": "工作人员给出明确的三步流程。 本段配单声部合成教学朗读，并非真人会话。",
      "audioId": "l20-dialogue-synth",
      "lines": [
        {
          "speaker": "客",
          "ja": "まず、何をしますか。",
          "kana": "まず、なにをしますか。",
          "zh": "首先做什么？"
        },
        {
          "speaker": "係",
          "ja": "受付に行ってください。",
          "kana": "うけつけにいってください。",
          "zh": "请先去接待处。"
        },
        {
          "speaker": "客",
          "ja": "次に、会場に入りますか。",
          "kana": "つぎに、かいじょうにはいりますか。",
          "zh": "然后进入会场吗？"
        },
        {
          "speaker": "係",
          "ja": "いいえ、荷物を預けてください。",
          "kana": "いいえ、にもつをあずけてください。",
          "zh": "不，先寄存行李。"
        },
        {
          "speaker": "客",
          "ja": "預けてから、入りますか。",
          "kana": "あずけてから、はいりますか。",
          "zh": "寄存后进入吗？"
        },
        {
          "speaker": "係",
          "ja": "はい。切符を見せてください。",
          "kana": "はい。きっぷをみせてください。",
          "zh": "是，请出示票。"
        },
        {
          "speaker": "客",
          "ja": "受付、荷物、切符ですね。",
          "kana": "うけつけ、にもつ、きっぷですね。",
          "zh": "接待、行李、票，对吧。"
        },
        {
          "speaker": "係",
          "ja": "はい、その順番です。",
          "kana": "はい、そのじゅんばんです。",
          "zh": "是，这个顺序。"
        }
      ]
    }
  ],
