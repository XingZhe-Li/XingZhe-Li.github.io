  "masteryCriteria": [
    "不看文本听『节庆后的感想』后，能记录最终决定或状态，并把未确认的信息标为未知。",
    "从两篇阅读中找到四道阅读题的依据，区分『节庆回顾』与变体材料的条件。",
    "关闭说明后，能在情境中使用かったです／くなかったです及でした／じゃありませんでした，而不只会背变形名称。",
    "换人物、时间、数量或条件后能用文字完成合适回应；实际口语与现场轮流接话需另行检验。"
  ],
  "dialogues": [
    {
      "id": "l16-d01",
      "title": "节庆后的感想",
      "context": "两人回顾上周，不用现在天气代替当时天气。 本段配单声部合成教学朗读，并非真人会话。",
      "audioId": "l16-dialogue-synth",
      "lines": [
        {
          "speaker": "ミナ",
          "ja": "先週の祭りはどうでしたか。",
          "kana": "せんしゅうのまつりはどうでしたか。",
          "zh": "上周节庆怎么样？"
        },
        {
          "speaker": "りん",
          "ja": "楽しかったです。",
          "kana": "たのしかったです。",
          "zh": "很愉快。"
        },
        {
          "speaker": "ミナ",
          "ja": "天気はよかったですか。",
          "kana": "てんきはよかったですか。",
          "zh": "天气好吗？"
        },
        {
          "speaker": "りん",
          "ja": "いいえ、雨でした。",
          "kana": "いいえ、あめでした。",
          "zh": "不，下雨。"
        },
        {
          "speaker": "ミナ",
          "ja": "寒かったですか。",
          "kana": "さむかったですか。",
          "zh": "冷吗？"
        },
        {
          "speaker": "りん",
          "ja": "はい、少し寒かったです。",
          "kana": "はい、すこしさむかったです。",
          "zh": "是，有点冷。"
        },
        {
          "speaker": "ミナ",
          "ja": "町は静かでしたか。",
          "kana": "まちはしずかでしたか。",
          "zh": "城里安静吗？"
        },
        {
          "speaker": "りん",
          "ja": "いいえ、とてもにぎやかでした。",
          "kana": "いいえ、とてもにぎやかでした。",
          "zh": "不，很热闹。"
        }
      ]
    }
  ],
