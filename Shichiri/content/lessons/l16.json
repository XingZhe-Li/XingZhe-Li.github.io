{
  "id": "l16",
  "number": 16,
  "moduleId": "m4",
  "title": "讲过去的状态与感受",
  "subtitle": "回顾一次活动，把当时感受与现在情况区分。",
  "revision": 2,
  "goals": [
    "表达过去的性质与感受。",
    "说明过去身份、天气和状态。",
    "在『节庆后的感想』以外的同类情境中，能根据对方回应调整自己的文字回答。"
  ],
  "prerequisites": [
    "已完成第15课及此前课目，遇到不理解时会请求重复和确认。",
    "先回忆已学名词、助词及相关动词；本课材料支持词可结合中文释义理解。"
  ],
  "days": [
    {
      "day": 1,
      "title": "整体理解",
      "description": "围绕「讲过去的状态与感受」完成整体理解；每块约20分钟，可与同组其他块连续学习。",
      "sections": [
        "dialogue",
        "reading",
        "practice"
      ],
      "exerciseIds": [
        "l16-ex01",
        "l16-ex03"
      ],
      "tasks": [
        {
          "title": "听读主材料",
          "instructions": "先不展开文本听「节庆后的感想」，记下双方的目标和最后的处理结果；再读分句核对，标出首次未听懂的词句。",
          "minutes": 10,
          "section": "dialogue"
        },
        {
          "title": "应用、核对与记录",
          "instructions": "阅读「节庆回顾」的情境，找出对象、条件和一项尚未确定的信息；完成本块题目并指出依据。",
          "minutes": 10,
          "section": "practice"
        }
      ]
    },
    {
      "day": 2,
      "title": "词汇与表达",
      "description": "围绕「讲过去的状态与感受」完成词汇与表达；每块约20分钟，可与同组其他块连续学习。",
      "sections": [
        "vocabulary",
        "practice"
      ],
      "exerciseIds": [
        "l16-ex19",
        "l16-ex20",
        "l16-ex21",
        "l16-ex22"
      ],
      "tasks": [
        {
          "title": "在语境中认识词句",
          "instructions": "在主材料中找到楽しい、忙しい、難しい、簡単，听独立朗读并结合例句确认当前词义，勿将全部识别词一次加入复习。",
          "minutes": 10,
          "section": "vocabulary"
        },
        {
          "title": "应用、核对与记录",
          "instructions": "遮住释义重做本块四道语境题，再用先週の祭りはどうでしたか。替换一个人物或条件；记下自己仍会混淆的搭配。",
          "minutes": 10,
          "section": "practice"
        }
      ]
    },
    {
      "day": 3,
      "title": "语法与替换",
      "description": "围绕「讲过去的状态与感受」完成语法与替换；每块约20分钟，可与同组其他块连续学习。",
