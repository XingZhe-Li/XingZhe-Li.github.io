  "grammar": [
    {
      "id": "l16-g1",
      "title": "い形容词过去",
      "meaning": "表达过去的性质与感受。",
      "pattern": "かったです／くなかったです",
      "explanation": "去い加かったです；否定为くなかったです。いい的过去是よかったです，作为例外。",
      "examples": [
        {
          "ja": "祭りは楽しかったです。",
          "zh": "节庆很愉快。"
        }
      ],
      "pitfall": "不能说楽しいでした。"
    },
    {
      "id": "l16-g2",
      "title": "名词及な形容词过去",
      "meaning": "说明过去身份、天气和状态。",
      "pattern": "でした／じゃありませんでした",
      "explanation": "名词与な形容词接でした；否定可用じゃありませんでした。",
      "examples": [
        {
          "ja": "昨日は雨でした。",
          "zh": "昨天下雨。"
        }
      ],
      "pitfall": "雨でした与雨が降りました的结构不同，后者只作支持理解。"
    }
  ],
