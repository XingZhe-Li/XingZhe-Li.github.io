  "masteryCriteria": [
    "不看文本听『课前见面』后，能记录最终决定或状态，并把未确认的信息标为未知。",
    "从两篇阅读中找到四道阅读题的依据，区分『教室时间』与变体材料的条件。",
    "关闭说明后，能在情境中使用时间に＋动作及から／まで，而不只会背变形名称。",
    "换人物、时间、数量或条件后能用文字完成合适回应；实际口语与现场轮流接话需另行检验。"
  ],
  "dialogues": [
    {
      "id": "l07-d01",
      "title": "课前见面",
      "context": "最后约定在课程开始前见面。 本段配单声部合成教学朗读，并非真人会话。",
      "audioId": "l07-dialogue-synth",
      "lines": [
        {
          "speaker": "りん",
          "ja": "授業は何時からですか。",
          "kana": "じゅぎょうはなんじからですか。",
          "zh": "课几点开始？"
        },
        {
          "speaker": "ミナ",
          "ja": "午前十時からです。",
          "kana": "ごぜんじゅうじからです。",
          "zh": "上午十点。"
        },
        {
          "speaker": "りん",
          "ja": "何時までですか。",
          "kana": "なんじまでですか。",
          "zh": "到几点？"
        },
        {
          "speaker": "ミナ",
          "ja": "十二時までです。",
          "kana": "じゅうにじまでです。",
          "zh": "到十二点。"
        },
        {
          "speaker": "りん",
          "ja": "月曜日ですか。",
          "kana": "げつようびですか。",
          "zh": "星期一吗？"
        },
        {
          "speaker": "ミナ",
          "ja": "いいえ、火曜日です。",
          "kana": "いいえ、かようびです。",
          "zh": "不，星期二。"
        },
        {
          "speaker": "りん",
          "ja": "九時半にお願いします。",
          "kana": "くじはんにおねがいします。",
          "zh": "请约九点半。"
        },
        {
          "speaker": "ミナ",
          "ja": "はい、九時半ですね。",
          "kana": "はい、くじはんですね。",
          "zh": "好，九点半。"
        }
      ]
    }
  ],
