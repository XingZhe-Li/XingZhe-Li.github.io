  "grammar": [
    {
      "id": "l07-g1",
      "title": "具体时刻",
      "meaning": "说明活动的开始时刻。",
      "pattern": "时间に＋动作",
      "explanation": "九時に等具体时刻用に。半是半小时；今日等相对时间通常不加に。",
      "examples": [
        {
          "ja": "授業は十時に始まります。",
          "zh": "课程十点开始。"
        }
      ],
      "pitfall": "见面时刻不等于开课时刻。"
    },
    {
      "id": "l07-g2",
      "title": "时间范围",
      "meaning": "区分开始与结束。",
      "pattern": "から／まで",
      "explanation": "から是起点，まで是终点；同时看星期和休息日。",
      "examples": [
        {
          "ja": "九時から五時までです。",
          "zh": "从九点到五点。"
        }
      ],
      "pitfall": "终点不是起点。"
    }
