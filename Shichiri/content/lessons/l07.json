{
  "id": "l07",
  "number": 7,
  "moduleId": "m2",
  "title": "询问时间与安排日程",
  "subtitle": "对照开放时间与约定时刻，避免把课前见面当开课。",
  "revision": 2,
  "goals": [
    "说明活动的开始时刻。",
    "区分开始与结束。",
    "在『课前见面』以外的同类情境中，能根据对方回应调整自己的文字回答。"
  ],
  "prerequisites": [
    "已完成第6课及此前课目，遇到不理解时会请求重复和确认。",
    "先回忆已学名词、助词及相关动词；本课材料支持词可结合中文释义理解。"
  ],
  "days": [
    {
      "day": 1,
      "title": "整体理解",
      "description": "围绕「询问时间与安排日程」完成整体理解；每块约20分钟，可与同组其他块连续学习。",
