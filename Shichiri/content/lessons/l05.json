      ],
      "exerciseIds": [
        "l05-ex11",
        "l05-ex12",
        "l05-ex13",
        "l05-ex14",
        "l05-ex16"
      ],
      "tasks": [
        {
          "title": "先组织自己的回应",
          "instructions": "根据本块新情境，从空白组织请求、解释或回应；先保留自己的初稿，再看示例，不把逐字一致当作唯一标准。",
          "minutes": 10,
          "section": "practice"
        },
        {
          "title": "应用、核对与记录",
          "instructions": "把当前课与前课的确认、理由或话题延续方式结合；修改一条回应，使对方能根据它采取明确的下一步行动。",
          "minutes": 10,
          "section": "practice"
        }
      ]
    },
    {
      "day": 7,
      "title": "验收与回顾",
      "description": "围绕「寻找人、物和地点」完成验收与回顾；每块约20分钟，可与同组其他块连续学习。",
      "sections": [
        "practice",
        "review"
      ],
      "exerciseIds": [
        "l05-ex06",
        "l05-ex10",
        "l05-ex17",
        "l05-ex18"
      ],
      "tasks": [
        {
          "title": "独立完成新变体",
          "instructions": "完成剩余新变体，不先打开范句；分别检查事实理解、接续与语气，以及自己的回应是否完成任务。",
          "minutes": 10,
          "section": "practice"
        },
        {
          "title": "应用、核对与记录",
          "instructions": "对照本课独立验收标准，把一个薄弱片段重新听读；为下次留下具体的补练目标。现场口语仍需后续单独实践。",
          "minutes": 10,
          "section": "practice"
        }
      ]
    }
  ],
  "extensionTasks": [
    {
      "id": "l05-ext10",
      "title": "寻找人、物和地点 · 10分钟迁移",
      "instructions": "先听『找老师与钥匙』而不展开文本，记录人物、要完成的事和最终回应。再核对原文，分别标出听出、重播后听出、看文本才理解的内容。产出三项事实与一处需重听的片段。",
      "minutes": 10,
      "section": "reading",
      "exerciseIds": []
    },
    {
      "id": "l05-ext15",
      "title": "寻找人、物和地点 · 15分钟迁移",
      "instructions": "读『学习空间位置单』与『隔壁房间』，做两列表对照，至少写两项相同和两项不同；再完成以下文字任务：问洗手间在哪里。 产出对照表和一段自己的回应。",
      "minutes": 15,
      "section": "grammar",
      "exerciseIds": []
    },
    {
      "id": "l05-ext25",
      "title": "寻找人、物和地点 · 25分钟迁移",
      "instructions": "用5分钟听『找老师与钥匙』并记关键信息，8分钟闭卷回答两篇阅读的四个问题，7分钟处理新情境：未听清位置，写请求重复。 最后5分钟核对范例并重写一轮。产出听辨笔记、四项阅读依据和自己的短回应；不把查看答案后的正确计为首次理解。",
      "minutes": 25,
      "section": "practice",
      "exerciseIds": [
        "l05-ex13",
        "l05-ex14"
      ]
    }
  ],
  "masteryCriteria": [
    "不看文本听『找老师与钥匙』后，能记录最终决定或状态，并把未确认的信息标为未知。",
    "从两篇阅读中找到四道阅读题的依据，区分『学习空间位置单』与变体材料的条件。",
    "关闭说明后，能在情境中使用物は場所にあります／人は場所にいます及名词の上／下／隣，而不只会背变形名称。",
    "换人物、时间、数量或条件后能用文字完成合适回应；实际口语与现场轮流接话需另行检验。"
  ],
  "dialogues": [
    {
      "id": "l05-d01",
      "title": "找老师与钥匙",
      "context": "访客先找人，再确认物的位置。 本段配单声部合成教学朗读，并非真人会话。",
      "audioId": "l05-dialogue-synth",
      "lines": [
        {
          "speaker": "客",
          "ja": "先生はどこですか。",
          "kana": "せんせいはどこですか。",
          "zh": "老师在哪里？"
        },
        {
          "speaker": "係",
          "ja": "図書室にいます。",
          "kana": "としょしつにいます。",
          "zh": "在阅览室。"
        },
        {
          "speaker": "客",
          "ja": "図書室はあそこですか。",
          "kana": "としょしつはあそこですか。",
          "zh": "阅览室是远处那里吗？"
        },
        {
          "speaker": "係",
          "ja": "はい。入口の隣です。",
          "kana": "はい。いりぐちのとなりです。",
          "zh": "对，在入口旁。"
        },
        {
          "speaker": "客",
          "ja": "かぎはどこですか。",
          "kana": "かぎはどこですか。",
          "zh": "钥匙在哪里？"
        },
        {
          "speaker": "係",
          "ja": "受付の机の上にあります。",
          "kana": "うけつけのつくえのうえにあります。",
          "zh": "在接待桌上。"
        },
        {
          "speaker": "客",
          "ja": "このかぎですか。",
          "kana": "このかぎですか。",
          "zh": "是这把钥匙吗？"
        },
        {
          "speaker": "係",
          "ja": "はい、そうです。",
          "kana": "はい、そうです。",
          "zh": "是的。"
        }
      ]
    }
  ],
