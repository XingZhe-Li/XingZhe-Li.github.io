  "grammar": [
    {
      "id": "l05-g1",
      "title": "存在动词",
      "meaning": "按对象选择存在表达。",
      "pattern": "物は場所にあります／人は場所にいます",
      "explanation": "钥匙、书等物用あります，人用います。先练已知对象的位置。",
      "examples": [
        {
          "ja": "先生は図書室にいます。",
          "zh": "老师在阅览室。"
        }
      ],
      "pitfall": "人不能用あります。"
    },
    {
      "id": "l05-g2",
      "title": "参照位置",
      "meaning": "根据参照物和方位找到物品。",
      "pattern": "名词の上／下／隣",
      "explanation": "先确认参照物，再确认上、下、隣；存在地点后用に。",
      "examples": [
        {
          "ja": "かぎは机の上にあります。",
          "zh": "钥匙在桌上。"
        }
      ],
      "pitfall": "不能把桌上与桌下混同。"
    }
  ],
