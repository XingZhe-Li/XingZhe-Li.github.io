  "masteryCriteria": [
    "不看文本听『机场与学校』后，能记录最终决定或状态，并把未确认的信息标为未知。",
    "从两篇阅读中找到四道阅读题的依据，区分『出行留言』与变体材料的条件。",
    "关闭说明后，能在情境中使用地点に／へ行きます及交通工具で／歩いて，而不只会背变形名称。",
    "换人物、时间、数量或条件后能用文字完成合适回应；实际口语与现场轮流接话需另行检验。"
  ],
  "dialogues": [
    {
      "id": "l08-d01",
      "title": "机场与学校",
      "context": "朋友们的目的地和交通方式不同。 本段配单声部合成教学朗读，并非真人会话。",
      "audioId": "l08-dialogue-synth",
      "lines": [
        {
          "speaker": "ミナ",
          "ja": "明日、どこに行きますか。",
          "kana": "あした、どこにいきますか。",
          "zh": "明天去哪里？"
        },
        {
          "speaker": "りん",
          "ja": "空港に行きます。",
          "kana": "くうこうにいきます。",
          "zh": "去机场。"
        },
        {
          "speaker": "ミナ",
          "ja": "バスで行きますか。",
          "kana": "バスでいきますか。",
          "zh": "乘公交吗？"
        },
        {
          "speaker": "りん",
          "ja": "いいえ、電車で行きます。",
          "kana": "いいえ、でんしゃでいきます。",
          "zh": "不，乘电车。"
        },
        {
          "speaker": "ミナ",
          "ja": "何時に行きますか。",
          "kana": "なんじにいきますか。",
          "zh": "几点去？"
        },
        {
          "speaker": "りん",
          "ja": "午前九時に行きます。",
          "kana": "ごぜんくじにいきます。",
          "zh": "上午九点。"
        },
        {
          "speaker": "りん",
          "ja": "ミナさんも空港ですか。",
          "kana": "ミナさんもくうこうですか。",
          "zh": "米娜也去机场吗？"
        },
        {
          "speaker": "ミナ",
          "ja": "いいえ、学校に行きます。",
          "kana": "いいえ、がっこうにいきます。",
          "zh": "不，我去学校。"
        }
      ]
    }
  ],
