{
  "id": "l14",
  "number": 14,
  "moduleId": "m3",
  "title": "表达想要与想做",
  "subtitle": "区分想得到物品、想做活动以及已经作出的选择。",
  "revision": 2,
  "goals": [
    "表达想得到哪件物品。",
    "表达活动愿望与当前选择。",
    "在『咨询处的愿望』以外的同类情境中，能根据对方回应调整自己的文字回答。"
  ],
  "prerequisites": [
    "已完成第13课及此前课目，遇到不理解时会请求重复和确认。",
    "先回忆已学名词、助词及相关动词；本课材料支持词可结合中文释义理解。"
  ],
  "days": [
    {
      "day": 1,
      "title": "整体理解",
      "description": "围绕「表达想要与想做」完成整体理解；每块约20分钟，可与同组其他块连续学习。",
      "sections": [
        "dialogue",
        "reading",
        "practice"
      ],
      "exerciseIds": [
        "l14-ex01",
        "l14-ex03"
      ],
      "tasks": [
        {
          "title": "听读主材料",
          "instructions": "先不展开文本听「咨询处的愿望」，记下双方的目标和最后的处理结果；再读分句核对，标出首次未听懂的词句。",
          "minutes": 10,
          "section": "dialogue"
        },
        {
          "title": "应用、核对与记录",
          "instructions": "阅读「咨询记录」的情境，找出对象、条件和一项尚未确定的信息；完成本块题目并指出依据。",
          "minutes": 10,
          "section": "practice"
        }
      ]
    },
    {
      "day": 2,
      "title": "词汇与表达",
      "description": "围绕「表达想要与想做」完成词汇与表达；每块约20分钟，可与同组其他块连续学习。",
      "sections": [
        "vocabulary",
        "practice"
      ],
      "exerciseIds": [
        "l14-ex19",
        "l14-ex20",
        "l14-ex21",
        "l14-ex22"
      ],
      "tasks": [
        {
          "title": "在语境中认识词句",
          "instructions": "在主材料中找到ほしい、たい、地図、切符，听独立朗读并结合例句确认当前词义，勿将全部识别词一次加入复习。",
          "minutes": 10,
          "section": "vocabulary"
        },
        {
          "title": "应用、核对与记录",
          "instructions": "遮住释义重做本块四道语境题，再用何がほしいですか。替换一个人物或条件；记下自己仍会混淆的搭配。",
          "minutes": 10,
          "section": "practice"
        }
      ]
    },
    {
      "day": 3,
      "title": "语法与替换",
      "description": "围绕「表达想要与想做」完成语法与替换；每块约20分钟，可与同组其他块连续学习。",
      "sections": [
        "grammar",
        "practice"
      ],
      "exerciseIds": [
        "l14-ex07",
        "l14-ex08",
        "l14-ex09"
      ],
      "tasks": [
        {
          "title": "比较规则与使用条件",
          "instructions": "对照「想要物品」「想做活动」的形式、作用和误区，给每条规则写一个适用条件和一个不适用条件。",
          "minutes": 10,
          "section": "grammar"
        },
        {
          "title": "应用、核对与记录",
          "instructions": "完成本块结构题；把一个例句的人物、时间或目的替换后重写，核对接续、否定和语气是否仍然成立。",
          "minutes": 10,
          "section": "practice"
        }
      ]
    },
    {
      "day": 4,
      "title": "听辨与回应",
      "description": "围绕「表达想要与想做」完成听辨与回应；每块约20分钟，可与同组其他块连续学习。",
      "sections": [
        "practice",
        "dialogue"
      ],
      "exerciseIds": [
        "l14-ex02",
        "l14-ex15"
      ],
      "tasks": [
        {
          "title": "先听后答",
          "instructions": "在不看原文的情况下播放本块音频，先记一条事实和一个最终意图；最多重播三次后再提交，不凭字幕作答。",
          "minutes": 10,
          "section": "practice"
        },
        {
          "title": "应用、核对与记录",
          "instructions": "提交本块题目后核对原文，区分首次听懂、重播听懂、看文本才懂的片段，并用一句文字确认最关键的信息。",
          "minutes": 10,
          "section": "practice"
        }
      ]
    },
    {
      "day": 5,
      "title": "阅读与组句",
      "description": "围绕「表达想要与想做」完成阅读与组句；每块约20分钟，可与同组其他块连续学习。",
      "sections": [
        "reading",
        "practice"
      ],
      "exerciseIds": [
        "l14-ex04",
        "l14-ex05"
      ],
      "tasks": [
        {
          "title": "比较两份材料",
          "instructions": "阅读「咨询记录」与「不同的休息方式」，按人物、目的、条件、结论做对照表；较长材料允许按段阅读。",
          "minutes": 10,
          "section": "reading"
        },
        {
          "title": "应用、核对与记录",
          "instructions": "完成本块阅读题并为答案找出具体句子；用简短日语或中文说明一个干扰项为何不成立。",
          "minutes": 10,
          "section": "practice"
        }
      ]
    },
    {
      "day": 6,
      "title": "应用与迁移",
      "description": "围绕「表达想要与想做」完成应用与迁移；每块约20分钟，可与同组其他块连续学习。",
      "sections": [
        "practice",
