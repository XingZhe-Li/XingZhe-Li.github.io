        "l14-ex18"
      ],
      "tasks": [
        {
          "title": "独立完成新变体",
          "instructions": "完成剩余新变体，不先打开范句；分别检查事实理解、接续与语气，以及自己的回应是否完成任务。",
          "minutes": 10,
          "section": "practice"
        },
        {
          "title": "应用、核对与记录",
          "instructions": "对照本课独立验收标准，把一个薄弱片段重新听读；为下次留下具体的补练目标。现场口语仍需后续单独实践。",
          "minutes": 10,
          "section": "practice"
        }
      ]
    }
  ],
  "extensionTasks": [
    {
      "id": "l14-ext10",
      "title": "表达想要与想做 · 10分钟迁移",
      "instructions": "先听『咨询处的愿望』而不展开文本，记录人物、要完成的事和最终回应。再核对原文，分别标出听出、重播后听出、看文本才理解的内容。产出三项事实与一处需重听的片段。",
      "minutes": 10,
      "section": "reading",
      "exerciseIds": []
    },
    {
      "id": "l14-ext15",
      "title": "表达想要与想做 · 15分钟迁移",
      "instructions": "读『咨询记录』与『不同的休息方式』，做两列表对照，至少写两项相同和两项不同；再完成以下文字任务：你想要地图，写一句。 产出对照表和一段自己的回应。",
      "minutes": 15,
      "section": "grammar",
      "exerciseIds": []
    },
    {
      "id": "l14-ext25",
      "title": "表达想要与想做 · 25分钟迁移",
      "instructions": "用5分钟听『咨询处的愿望』并记关键信息，8分钟闭卷回答两篇阅读的四个问题，7分钟处理新情境：对方以为你已经拍照，说明这只是愿望。 最后5分钟核对范例并重写一轮。产出听辨笔记、四项阅读依据和自己的短回应；不把查看答案后的正确计为首次理解。",
      "minutes": 25,
      "section": "practice",
      "exerciseIds": [
        "l14-ex13",
        "l14-ex14"
      ]
    }
  ],
  "masteryCriteria": [
    "不看文本听『咨询处的愿望』后，能记录最终决定或状态，并把未确认的信息标为未知。",
    "从两篇阅读中找到四道阅读题的依据，区分『咨询记录』与变体材料的条件。",
    "关闭说明后，能在情境中使用名词がほしいです及动词ます词干＋たいです，而不只会背变形名称。",
    "换人物、时间、数量或条件后能用文字完成合适回应；实际口语与现场轮流接话需另行检验。"
  ],
  "dialogues": [
    {
      "id": "l14-d01",
      "title": "咨询处的愿望",
      "context": "游客说明需求，并未说明已经完成购买或活动。 本段配单声部合成教学朗读，并非真人会话。",
      "audioId": "l14-dialogue-synth",
      "lines": [
        {
          "speaker": "係",
          "ja": "何がほしいですか。",
          "kana": "なにがほしいですか。",
          "zh": "想要什么？"
        },
        {
          "speaker": "客",
          "ja": "地図がほしいです。",
          "kana": "ちずがほしいです。",
          "zh": "想要地图。"
        },
        {
          "speaker": "係",
          "ja": "山に行きたいですか。",
          "kana": "やまにいきたいですか。",
          "zh": "想去山里吗？"
        },
        {
          "speaker": "客",
          "ja": "いいえ、海に行きたいです。",
          "kana": "いいえ、うみにいきたいです。",
          "zh": "不，想去海边。"
        },
        {
          "speaker": "係",
          "ja": "写真を撮りたいですか。",
          "kana": "しゃしんをとりたいですか。",
          "zh": "想拍照吗？"
        },
        {
          "speaker": "客",
          "ja": "はい、撮りたいです。",
          "kana": "はい、とりたいです。",
          "zh": "是，想拍。"
        },
        {
          "speaker": "係",
          "ja": "この地図ですか。",
          "kana": "このちずですか。",
          "zh": "是这张地图吗？"
        },
        {
          "speaker": "客",
          "ja": "はい、この地図にします。",
          "kana": "はい、このちずにします。",
          "zh": "是，我选这张。"
        }
      ]
    }
  ],
