  "masteryCriteria": [
    "不看文本听『早餐桌上的选择』后，能记录最终决定或状态，并把未确认的信息标为未知。",
    "从两篇阅读中找到四道阅读题的依据，区分『活动备忘』与变体材料的条件。",
    "关闭说明后，能在情境中使用ます／ません及名词を＋动词，而不只会背变形名称。",
    "换人物、时间、数量或条件后能用文字完成合适回应；实际口语与现场轮流接话需另行检验。"
  ],
  "dialogues": [
    {
      "id": "l06-d01",
      "title": "早餐桌上的选择",
      "context": "两位学生确认早餐和活动。 本段配单声部合成教学朗读，并非真人会话。",
      "audioId": "l06-dialogue-synth",
      "lines": [
        {
          "speaker": "ミナ",
          "ja": "朝ご飯を食べますか。",
          "kana": "あさごはんをたべますか。",
          "zh": "吃早餐吗？"
        },
        {
          "speaker": "りん",
          "ja": "はい、パンを食べます。",
          "kana": "はい、パンをたべます。",
          "zh": "吃，吃面包。"
        },
        {
          "speaker": "ミナ",
          "ja": "お茶を飲みますか。",
          "kana": "おちゃをのみますか。",
          "zh": "喝茶吗？"
        },
        {
          "speaker": "りん",
          "ja": "いいえ、水を飲みます。",
          "kana": "いいえ、みずをのみます。",
          "zh": "不，喝水。"
        },
        {
          "speaker": "ミナ",
          "ja": "新聞を読みますか。",
          "kana": "しんぶんをよみますか。",
          "zh": "读报吗？"
        },
        {
          "speaker": "りん",
          "ja": "いいえ、新聞は読みません。",
          "kana": "いいえ、しんぶんはよみません。",
          "zh": "不，不读报纸。"
        },
        {
          "speaker": "ミナ",
          "ja": "日本語を勉強しますか。",
          "kana": "にほんごをべんきょうしますか。",
          "zh": "学日语吗？"
        },
        {
          "speaker": "りん",
          "ja": "はい、本を読みます。",
          "kana": "はい、ほんをよみます。",
          "zh": "学，读书。"
        }
      ]
    }
  ],
