    {
      "id": "l06-g1",
      "title": "礼貌动作肯否",
      "meaning": "分清进行的活动与否定的活动。",
      "pattern": "ます／ません",
      "explanation": "ます形式在本课表示礼貌动作；ません否定动作。先不要求从辞书形变换。",
      "examples": [
        {
          "ja": "新聞は読みません。",
          "zh": "不读报纸。"
        }
      ],
      "pitfall": "不做不是已经做完。"
    },
    {
      "id": "l06-g2",
      "title": "动作对象",
      "meaning": "说清吃、喝、读的对象。",
      "pattern": "名词を＋动词",
      "explanation": "を作助词读お；动词需与对象意义相配。",
      "examples": [
        {
          "ja": "パンを食べます。",
          "zh": "吃面包。"
        }
      ],
      "pitfall": "水通常与飲みます搭配。"
    }
