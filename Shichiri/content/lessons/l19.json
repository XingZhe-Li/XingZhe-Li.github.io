{
  "id": "l19",
  "number": 19,
  "moduleId": "m4",
  "title": "描述动作与当前状态",
  "subtitle": "判断照片中的动作与当前生活状态，不把两种ています都理解为此刻正在做。",
  "revision": 2,
  "goals": [
    "描述当前进行的动作。",
    "理解持续生活状态。",
    "在『视频画面中的朋友』以外的同类情境中，能根据对方回应调整自己的文字回答。"
  ],
  "prerequisites": [
    "已完成第18课及此前课目，遇到不理解时会请求重复和确认。",
    "先回忆已学名词、助词及相关动词；本课材料支持词可结合中文释义理解。"
  ],
