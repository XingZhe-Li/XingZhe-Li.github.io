          "speaker": "ミナ",
          "ja": "いいえ、大阪に住んでいます。",
          "kana": "いいえ、おおさかにすんでいます。",
          "zh": "不，住大阪。"
        },
        {
          "speaker": "りん",
          "ja": "けんさんは何をしていますか。",
          "kana": "けんさんはなにをしていますか。",
          "zh": "健正在做什么？"
        },
        {
          "speaker": "ミナ",
          "ja": "写真を撮っています。",
          "kana": "しゃしんをとっています。",
          "zh": "正在拍照。"
        },
        {
          "speaker": "りん",
          "ja": "あの店で働いていますか。",
          "kana": "あのみせではたらいていますか。",
          "zh": "他在那家店工作吗？"
        },
        {
          "speaker": "ミナ",
          "ja": "はい、あの店で働いています。",
          "kana": "はい、あのみせではたらいています。",
          "zh": "是，在那家店工作。"
        }
      ]
    }
