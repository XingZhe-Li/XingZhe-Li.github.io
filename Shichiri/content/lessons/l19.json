          "minutes": 10,
          "section": "dialogue"
        },
        {
          "title": "应用、核对与记录",
          "instructions": "阅读「今与生活情况」的情境，找出对象、条件和一项尚未确定的信息；完成本块题目并指出依据。",
          "minutes": 10,
          "section": "practice"
        }
      ]
