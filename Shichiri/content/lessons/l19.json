  "masteryCriteria": [
    "不看文本听『视频画面中的朋友』后，能记录最终决定或状态，并把未确认的信息标为未知。",
    "从两篇阅读中找到四道阅读题的依据，区分『今与生活情况』与变体材料的条件。",
    "关闭说明后，能在情境中使用て形＋います及住んでいます／働いています，而不只会背变形名称。",
    "换人物、时间、数量或条件后能用文字完成合适回应；实际口语与现场轮流接话需另行检验。"
  ],
  "dialogues": [
    {
      "id": "l19-d01",
      "title": "视频画面中的朋友",
      "context": "朋友说明当前动作和居住地。 本段配单声部合成教学朗读，并非真人会话。",
