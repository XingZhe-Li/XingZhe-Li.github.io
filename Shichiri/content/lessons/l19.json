      "id": "l19-g1",
      "title": "正在进行",
      "meaning": "描述当前进行的动作。",
      "pattern": "て形＋います",
      "explanation": "読んでいます、使っています等表示正在进行；需结合今等时间语境。",
      "examples": [
        {
          "ja": "今、本を読んでいます。",
          "zh": "正在读书。"
        }
      ],
      "pitfall": "正在动作不等于已经做完。"
    },
    {
      "id": "l19-g2",
      "title": "生活状态",
      "meaning": "理解持续生活状态。",
      "pattern": "住んでいます／働いています",
      "explanation": "住んでいます表示居住；不表示此刻正在搬家。働いています有职业或当前工作两种解释，结合地点与今判断。",
      "examples": [
        {
          "ja": "東京に住んでいます。",
          "zh": "住在东京。"
        }
      ],
      "pitfall": "不用住みます来机械替换所有当前居住状态。"
    }
