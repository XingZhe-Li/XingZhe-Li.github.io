          "speaker": "りん",
          "ja": "今、何をしていますか。",
          "kana": "いま、なにをしていますか。",
          "zh": "现在做什么？"
        },
        {
          "speaker": "ミナ",
          "ja": "本を読んでいます。",
          "kana": "ほんをよんでいます。",
          "zh": "正在读书。"
        },
        {
          "speaker": "りん",
          "ja": "東京に住んでいますか。",
          "kana": "とうきょうにすんでいますか。",
          "zh": "住在东京吗？"
        },
