  "grammar": [
    {
      "id": "l10-g1",
      "title": "过去动作",
      "meaning": "讲已经发生的活动。",
      "pattern": "ました",
      "explanation": "ます换成ました用于礼貌过去；时间词昨日帮助识别参照时间。",
      "examples": [
        {
          "ja": "昨日、図書館に行きました。",
          "zh": "昨天去了图书馆。"
        }
      ],
      "pitfall": "不要把昨日的完成事件说成当前习惯。"
    },
    {
      "id": "l10-g2",
      "title": "过去否定",
      "meaning": "说明过去没有发生的活动。",
      "pattern": "ませんでした",
      "explanation": "ませんでした否定过去事件，区别现在或习惯的ません。",
      "examples": [
        {
          "ja": "映画は見ませんでした。",
          "zh": "没有看电影。"
        }
      ],
      "pitfall": "没看电影不能推出没出门。"
    }
  ],
