  "masteryCriteria": [
    "不看文本听『交换昨日记录』后，能记录最终决定或状态，并把未确认的信息标为未知。",
    "从两篇阅读中找到四道阅读题的依据，区分『昨天的短日记』与变体材料的条件。",
    "关闭说明后，能在情境中使用ました及ませんでした，而不只会背变形名称。",
    "换人物、时间、数量或条件后能用文字完成合适回应；实际口语与现场轮流接话需另行检验。"
  ],
  "dialogues": [
    {
      "id": "l10-d01",
      "title": "交换昨日记录",
      "context": "朋友核对过去实际做的事。 本段配单声部合成教学朗读，并非真人会话。",
      "audioId": "l10-dialogue-synth",
      "lines": [
        {
          "speaker": "ミナ",
          "ja": "昨日、何をしましたか。",
          "kana": "きのう、なにをしましたか。",
          "zh": "昨天做了什么？"
        },
        {
          "speaker": "りん",
          "ja": "図書館で本を読みました。",
          "kana": "としょかんでほんをよみました。",
          "zh": "在图书馆读书。"
        },
        {
          "speaker": "ミナ",
          "ja": "映画も見ましたか。",
          "kana": "えいがもみましたか。",
          "zh": "也看电影了吗？"
        },
        {
          "speaker": "りん",
          "ja": "いいえ、見ませんでした。",
          "kana": "いいえ、みませんでした。",
          "zh": "没有看。"
        },
        {
          "speaker": "ミナ",
          "ja": "夜は何をしましたか。",
          "kana": "よるはなにをしましたか。",
          "zh": "晚上做什么了？"
        },
        {
          "speaker": "りん",
          "ja": "家で料理しました。",
          "kana": "いえでりょうりしました。",
          "zh": "在家做饭。"
        },
        {
          "speaker": "ミナ",
          "ja": "宿題をしましたか。",
          "kana": "しゅくだいをしましたか。",
          "zh": "做作业了吗？"
        },
        {
          "speaker": "りん",
          "ja": "はい。日記も書きました。",
          "kana": "はい。にっきもかきました。",
          "zh": "做了，也写日记了。"
        }
      ]
    }
  ],
