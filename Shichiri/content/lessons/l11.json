        "l11-ex18"
      ],
      "tasks": [
        {
          "title": "独立完成新变体",
          "instructions": "完成剩余新变体，不先打开范句；分别检查事实理解、接续与语气，以及自己的回应是否完成任务。",
          "minutes": 10,
          "section": "practice"
        },
        {
          "title": "应用、核对与记录",
          "instructions": "对照本课独立验收标准，把一个薄弱片段重新听读；为下次留下具体的补练目标。现场口语仍需后续单独实践。",
          "minutes": 10,
          "section": "practice"
        }
      ]
    }
  ],
