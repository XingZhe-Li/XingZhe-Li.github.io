  "masteryCriteria": [
    "不看文本听『冷热饮料与蛋糕』后，能记录最终决定或状态，并把未确认的信息标为未知。",
    "从两篇阅读中找到四道阅读题的依据，区分『食堂介绍』与变体材料的条件。",
    "关闭说明后，能在情境中使用いです／くないです及とても／あまり＋否定，而不只会背变形名称。",
    "换人物、时间、数量或条件后能用文字完成合适回应；实际口语与现场轮流接话需另行检验。"
  ],
  "dialogues": [
    {
      "id": "l11-d01",
      "title": "冷热饮料与蛋糕",
      "context": "顾客比较甜度和温度；不讨论尚未学的比较句型。 本段配单声部合成教学朗读，并非真人会话。",
      "audioId": "l11-dialogue-synth",
      "lines": [
        {
          "speaker": "客",
          "ja": "このケーキは甘いですか。",
          "kana": "このケーキはあまいですか。",
          "zh": "这蛋糕甜吗？"
        },
        {
          "speaker": "店員",
          "ja": "はい、とても甘いです。",
          "kana": "はい、とてもあまいです。",
          "zh": "是，非常甜。"
        },
        {
          "speaker": "客",
          "ja": "この料理は辛いですか。",
          "kana": "このりょうりはからいですか。",
          "zh": "这道菜辣吗？"
        },
        {
          "speaker": "店員",
          "ja": "いいえ、辛くないです。",
          "kana": "いいえ、からくないです。",
          "zh": "不，不辣。"
        },
        {
          "speaker": "客",
          "ja": "お茶は熱いですか。",
          "kana": "おちゃはあついですか。",
          "zh": "茶烫吗？"
        },
        {
          "speaker": "店員",
          "ja": "はい、熱いです。",
          "kana": "はい、あついです。",
          "zh": "是，烫。"
        },
        {
          "speaker": "客",
          "ja": "水はどうですか。",
          "kana": "みずはどうですか。",
          "zh": "水怎么样？"
        },
        {
          "speaker": "店員",
          "ja": "水は冷たいです。",
          "kana": "みずはつめたいです。",
          "zh": "水是冰凉的。"
        }
      ]
    }
  ],
