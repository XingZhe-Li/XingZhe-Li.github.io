        "l11-ex16"
      ],
      "tasks": [
        {
          "title": "先组织自己的回应",
          "instructions": "根据本块新情境，从空白组织请求、解释或回应；先保留自己的初稿，再看示例，不把逐字一致当作唯一标准。",
          "minutes": 10,
          "section": "practice"
        },
        {
          "title": "应用、核对与记录",
          "instructions": "把当前课与前课的确认、理由或话题延续方式结合；修改一条回应，使对方能根据它采取明确的下一步行动。",
          "minutes": 10,
          "section": "practice"
        }
      ]
    },
    {
      "day": 7,
      "title": "验收与回顾",
      "description": "围绕「描述食物、物品和天气」完成验收与回顾；每块约20分钟，可与同组其他块连续学习。",
      "sections": [
        "practice",
