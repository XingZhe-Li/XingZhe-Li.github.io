  "grammar": [
    {
      "id": "l11-g1",
      "title": "い形容词肯否",
      "meaning": "描述特点并否定某个特点。",
      "pattern": "いです／くないです",
      "explanation": "否定时去末尾い加くないです。おいしい变为おいしくないです。",
      "examples": [
        {
          "ja": "この料理は辛くないです。",
          "zh": "这道菜不辣。"
        }
      ],
      "pitfall": "不辣不等于不甜。"
    },
    {
      "id": "l11-g2",
      "title": "程度",
      "meaning": "表达评价的程度。",
      "pattern": "とても／あまり＋否定",
      "explanation": "とても加强程度；あまり常与否定配合表示不太。",
      "examples": [
        {
          "ja": "このパンはあまり高くないです。",
          "zh": "这个面包不太贵。"
        }
      ],
      "pitfall": "热饮的熱い与天气的暑い写法不同。"
    }
  ],
