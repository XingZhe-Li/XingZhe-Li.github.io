{
  "id": "l11",
  "number": 11,
  "moduleId": "m3",
  "title": "描述食物、物品和天气",
  "subtitle": "区分食物温度、味道与价格，不把一种评价当全部评价。",
  "revision": 2,
  "goals": [
    "描述特点并否定某个特点。",
    "表达评价的程度。",
    "在『冷热饮料与蛋糕』以外的同类情境中，能根据对方回应调整自己的文字回答。"
  ],
  "prerequisites": [
    "已完成第10课及此前课目，遇到不理解时会请求重复和确认。",
    "先回忆已学名词、助词及相关动词；本课材料支持词可结合中文释义理解。"
  ],
  "days": [
    {
      "day": 1,
      "title": "整体理解",
      "description": "围绕「描述食物、物品和天气」完成整体理解；每块约20分钟，可与同组其他块连续学习。",
      "sections": [
        "dialogue",
        "reading",
        "practice"
      ],
      "exerciseIds": [
        "l11-ex01",
        "l11-ex03"
      ],
      "tasks": [
        {
          "title": "听读主材料",
          "instructions": "先不展开文本听「冷热饮料与蛋糕」，记下双方的目标和最后的处理结果；再读分句核对，标出首次未听懂的词句。",
          "minutes": 10,
          "section": "dialogue"
        },
        {
          "title": "应用、核对与记录",
          "instructions": "阅读「食堂介绍」的情境，找出对象、条件和一项尚未确定的信息；完成本块题目并指出依据。",
          "minutes": 10,
          "section": "practice"
        }
      ]
    },
    {
      "day": 2,
      "title": "词汇与表达",
      "description": "围绕「描述食物、物品和天气」完成词汇与表达；每块约20分钟，可与同组其他块连续学习。",
      "sections": [
        "vocabulary",
        "practice"
      ],
      "exerciseIds": [
        "l11-ex19",
        "l11-ex20",
        "l11-ex21",
        "l11-ex22"
      ],
      "tasks": [
        {
          "title": "在语境中认识词句",
          "instructions": "在主材料中找到おいしい、熱い、冷たい、高い，听独立朗读并结合例句确认当前词义，勿将全部识别词一次加入复习。",
          "minutes": 10,
          "section": "vocabulary"
        },
        {
          "title": "应用、核对与记录",
          "instructions": "遮住释义重做本块四道语境题，再用このケーキは甘いですか。替换一个人物或条件；记下自己仍会混淆的搭配。",
          "minutes": 10,
          "section": "practice"
        }
      ]
    },
    {
      "day": 3,
      "title": "语法与替换",
      "description": "围绕「描述食物、物品和天气」完成语法与替换；每块约20分钟，可与同组其他块连续学习。",
      "sections": [
        "grammar",
        "practice"
      ],
      "exerciseIds": [
        "l11-ex07",
        "l11-ex08",
        "l11-ex09"
      ],
      "tasks": [
        {
          "title": "比较规则与使用条件",
          "instructions": "对照「い形容词肯否」「程度」的形式、作用和误区，给每条规则写一个适用条件和一个不适用条件。",
          "minutes": 10,
          "section": "grammar"
        },
        {
          "title": "应用、核对与记录",
          "instructions": "完成本块结构题；把一个例句的人物、时间或目的替换后重写，核对接续、否定和语气是否仍然成立。",
          "minutes": 10,
          "section": "practice"
        }
      ]
    },
    {
      "day": 4,
      "title": "听辨与回应",
      "description": "围绕「描述食物、物品和天气」完成听辨与回应；每块约20分钟，可与同组其他块连续学习。",
      "sections": [
        "practice",
        "dialogue"
      ],
      "exerciseIds": [
        "l11-ex02",
        "l11-ex15"
      ],
      "tasks": [
        {
          "title": "先听后答",
          "instructions": "在不看原文的情况下播放本块音频，先记一条事实和一个最终意图；最多重播三次后再提交，不凭字幕作答。",
          "minutes": 10,
          "section": "practice"
        },
        {
          "title": "应用、核对与记录",
          "instructions": "提交本块题目后核对原文，区分首次听懂、重播听懂、看文本才懂的片段，并用一句文字确认最关键的信息。",
          "minutes": 10,
          "section": "practice"
        }
      ]
    },
    {
      "day": 5,
      "title": "阅读与组句",
      "description": "围绕「描述食物、物品和天气」完成阅读与组句；每块约20分钟，可与同组其他块连续学习。",
      "sections": [
        "reading",
        "practice"
      ],
      "exerciseIds": [
        "l11-ex04",
        "l11-ex05"
      ],
      "tasks": [
        {
          "title": "比较两份材料",
          "instructions": "阅读「食堂介绍」与「天气变了的另一天」，按人物、目的、条件、结论做对照表；较长材料允许按段阅读。",
          "minutes": 10,
          "section": "reading"
        },
        {
          "title": "应用、核对与记录",
          "instructions": "完成本块阅读题并为答案找出具体句子；用简短日语或中文说明一个干扰项为何不成立。",
          "minutes": 10,
          "section": "practice"
        }
      ]
    },
    {
      "day": 6,
      "title": "应用与迁移",
      "description": "围绕「描述食物、物品和天气」完成应用与迁移；每块约20分钟，可与同组其他块连续学习。",
      "sections": [
